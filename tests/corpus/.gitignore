# Godot project cache
.godot/

# Build artifacts staged in by run_corpus.sh (not source)
/godot-usd.gdextension
/lib/

# corpusd (host test-runner daemon) channel + logs
/.corpusd/

# The corpus sample .usdz files are TEST FIXTURES, not build outputs — re-include them despite the
# repo-root `*.usdz` ignore (parent dirs aren't excluded, so this negation takes effect).
!/samples/*.usdz
